# Production / VPS env — copy ONCE to .env.prod and fill real values.
#   cp .env.prod.example .env.prod
# Never commit .env.prod
#
# IMPORTANT: .env.prod is gitignored. After `git pull`, do NOT run
#   cp .env.prod.example .env.prod
# that overwrites your live secrets. Only merge NEW keys manually if this
# example gains new variables.

COMPOSE_PROJECT_NAME=facinect

APP_ENV=production

POSTGRES_IDENTITY_DB=fac_identity
POSTGRES_IDENTITY_USER=identity
POSTGRES_IDENTITY_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

REDIS_PASSWORD=

# Public portal (HTTPS)
JWT_ISSUER=https://cloud.facinect.com
JWT_AUDIENCE=facinect-apps
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

BOOTSTRAP_ADMIN_EMAIL=admin@facinect.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_NAME="Facinect Admin"

# Google OAuth — add this exact redirect URI in Google Console:
#   https://cloud.facinect.com/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://cloud.facinect.com/v1/auth/google/callback

# Production: never use * (services refuse wildcard CORS when APP_ENV=production)
CORS_ORIGINS=https://cloud.facinect.com

# Host port for Traefik gateway (RoutForge already uses 8080).
# Put nginx/Caddy on :443 → http://127.0.0.1:8081 for HTTPS.
FACINECT_HTTP_PORT=8081

# Notifications — REQUIRED in production (empty key = all mutate APIs 401)
NOTIFICATIONS_SERVICE_KEY=CHANGE_ME_NOTIFICATIONS_SERVICE_KEY
NOTIFICATIONS_DRY_RUN=false
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v21.0
FCM_SERVER_KEY=
FCM_SERVICE_ACCOUNT_JSON=/secrets/fcm_service_account.json
FCM_PROJECT_ID=myproject7708-c90d5

# Booking
BOOKING_SERVICE_KEY=CHANGE_ME_BOOKING_SERVICE_KEY
STUDENTS_SERVICE_KEY=CHANGE_ME_STUDENTS_SERVICE_KEY
MEMBERS_SERVICE_KEY=CHANGE_ME_MEMBERS_SERVICE_KEY
TOURNAMENTS_SERVICE_KEY=CHANGE_ME_TOURNAMENTS_SERVICE_KEY
AI_SERVICE_KEY=CHANGE_ME_AI_SERVICE_KEY
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash
ENQUIRY_SERVICE_KEY=CHANGE_ME_ENQUIRY_SERVICE_KEY
OFFERS_SERVICE_KEY=CHANGE_ME_OFFERS_SERVICE_KEY
ADMINISTRATION_SERVICE_KEY=CHANGE_ME_ADMINISTRATION_SERVICE_KEY
ADDFACILITY_SERVICE_KEY=CHANGE_ME_ADDFACILITY_SERVICE_KEY
PLATFORM_SERVICE_KEY=CHANGE_ME_PLATFORM_SERVICE_KEY
APP_SERVICE_KEY=CHANGE_ME_APP_SERVICE_KEY
PAYMENTS_SERVICE_KEY=CHANGE_ME_PAYMENTS_SERVICE_KEY
PAYGATEWAY_SERVICE_KEY=CHANGE_ME_PAYGATEWAY_SERVICE_KEY
GATEWAY_DEFAULT_PROVIDER=razorpay
RAZORPAY_KEY_ID=CHANGE_ME_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=CHANGE_ME_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_RAZORPAY_WEBHOOK_SECRET
BOOKING_OPEN_HOUR=6
BOOKING_CLOSE_HOUR=22
BOOKING_SLOT_MINUTES=60
